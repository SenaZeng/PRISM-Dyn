integrator  = md
dt          = 0.002
constraint_algorithm = lincs
constraints = h-bonds
lincs_iter  = 2
lincs_order = 4
cutoff-scheme = Verlet
nstlist     = 20
rcoulomb    = 1.0
rvdw        = 1.0
coulombtype = PME
tcoupl      = V-rescale
tc-grps     = Protein_MOL Water_and_ions
tau_t       = 0.5 0.5
ref_t       = 300 300
pbc         = xyz
nstxout     = 0
nstvout     = 0
nsteps      = 50000000
continuation = yes
pcoupl      = Parrinello-Rahman
pcoupltype  = isotropic
tau_p       = 2.0
ref_p       = 1.0
compressibility = 4.5e-5
nstxout-compressed = 5000
compressed-x-grps   = System
nstenergy   = 1000
nstlog      = 1000
